{
  "name": "ArchitectureProposal",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string",
      "description": "Full description of the proposed structural change"
    },
    "proposal_type": {
      "type": "string",
      "enum": [
        "mapping_path",
        "frequency_expansion",
        "grid_structure",
        "trait_system",
        "consciousness_layer",
        "other"
      ]
    },
    "proposed_by": {
      "type": "string",
      "description": "Email of the proposing developer"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending_ai",
        "pending_approval",
        "approved",
        "rejected"
      ],
      "default": "pending_ai"
    },
    "ai_analysis": {
      "type": "string",
      "description": "AI filtering and analysis of this proposal"
    },
    "ai_alignment_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 100,
      "description": "AI-assessed alignment with system purpose (0-100)"
    },
    "ai_flags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Any concerns or flags raised by AI"
    },
    "admin_decision_note": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "description",
    "proposal_type",
    "proposed_by"
  ],
  "rls": {
    "create": {
      "created_by": "{{user.email}}"
    }
  }
}