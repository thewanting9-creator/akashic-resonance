{
  "name": "SR Surge Email Alert",
  "description": "Fires srPeakEmailAlert whenever a sr_peak_alert record is created in ResonanceArchive",
  "trigger": {
    "condition": "${ (.trigger.data.snapshot_type == \"sr_peak_alert\") }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "create"
      ],
      "entity_name": "ResonanceArchive"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "sr_surge_email_alert",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "srPeakEmailAlert",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "srPeakEmailAlert"
  }
}